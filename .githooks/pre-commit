#!/bin/sh
# Installed by `pnpm install` (see package.json "prepare"). Rewrite ambiguous
# placeholders for false positives; never bypass the check. Rotate real keys.
set -e
node scripts/check-secrets.mjs --staged
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact
else
  echo "ℹ gitleaks not installed; only the built-in check ran. brew install gitleaks for full coverage."
fi
